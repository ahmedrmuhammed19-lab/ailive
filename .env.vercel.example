# Vercel environment variables — set these in the Vercel dashboard
# (Project → Settings → Environment Variables) or they are injected
# automatically when you attach the matching store.

# 1. DATABASE_URL — injected automatically by Vercel when you attach a
#    Postgres store (Neon). Format:
#    postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# 2. BLOB_READ_WRITE_TOKEN — NOT needed. On hosted deploys, uploaded statements
#    and published reports are stored in the Postgres database (bytea) and served
#    through session-guarded API routes. Only set a Blob token if you explicitly
#    want Vercel Blob object storage instead.

# 3. SESSION_SECRET — REQUIRED, set manually. Random 64-char hex:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-64-hex-string

# 4. SETUP_KEY — REQUIRED until the first account exists. Used once, on the
#    live portal, to create the first operator account (the setup form appears
#    automatically while the portal has zero accounts). Random 32-char hex:
#    python3 -c "import secrets; print(secrets.token_hex(16))"
SETUP_KEY=change-me-to-a-random-32-hex-string

# 5. MAIL_CREDS_JSON — optional; enables live SMTP email from the Vercel
#    deployment (without it, the portal works but email sending is skipped).
#    Same JSON shape as config/mail_credentials.json, minified to one line:
MAIL_CREDS_JSON={"provider":"brevo","host":"smtp-relay.brevo.com","port":587,"secure":false,"email":"your-signup-email@gmail.com","app_password":"your-smtp-key","notify_to":"ahmedr.muhammed19@gmail.com"}

# 6. AUTO_DELIVER_MIN — optional; minimum per-account ledger-chain integrity
#    (verified rows / total rows) required to auto-deliver the report and mark
#    DONE in the same tap. Default 1 = 100%: every row on every account must
#    reconcile against the bank's own balances; anything below parks the draft
#    for review and emails the operator. Loosen to e.g. 0.95 for OCR tolerance.
#    AUTO_DELIVER=0 disables auto-delivery entirely.
#AUTO_DELIVER_MIN=1

# 7. LESSON_MAIL_COOLDOWN_MIN — optional; minimum minutes between "engine
#    learned a new lesson" operator emails. The engine emails you only the
#    FIRST time it sees a failure pattern (new unrecognized layout, or a new
#    chain-failure row pattern per layout family); the cooldown additionally
#    caps bursts of several brand-new patterns landing together. Default 15.
#LESSON_MAIL_COOLDOWN_MIN=15
