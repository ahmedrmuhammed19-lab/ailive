{
  "_readme": [
    "Copy this file to config/mail_credentials.json and fill it in.",
    "Gmail app password NOT available on your account? Use Brevo or SendGrid instead —",
    "both are free, need only a normal signup (no 2FA, no app password), and can",
    "deliver to any Gmail address including ahmedr.muhammed19@gmail.com.",
    "",
    "OPTION A — Brevo (recommended, 300 emails/day free):",
    "  1. Sign up at https://app.brevo.com with your Gmail address.",
    "  2. Profile (top-right) -> SMTP & API -> generate an SMTP key.",
    "  3. Senders -> add & verify your Gmail address (click the email they send).",
    "  4. Fill: host smtp-relay.brevo.com, port 587, secure false,",
    "     email = your Brevo signup email, app_password = the SMTP key.",
    "",
    "OPTION B — SendGrid (100 emails/day free):",
    "  1. Sign up at https://app.sendgrid.com, verify single sender (your Gmail).",
    "  2. Settings -> API Keys -> Create key with 'Mail Send' access.",
    "  3. Fill: host smtp.sendgrid.net, port 587, secure false,",
    "     email = 'apikey' (literally that word), app_password = the API key.",
    "",
    "OPTION C — Gmail app password (only if 2-Step Verification can be enabled):",
    "  Leave host/port/secure out entirely — defaults to smtp.gmail.com:465 SSL.",
    "",
    "notify_to = where operator alerts are sent (defaults to ahmedr.muhammed19@gmail.com)."
  ],
  "provider": "brevo",
  "host": "smtp-relay.brevo.com",
  "port": 587,
  "secure": false,
  "email": "your-signup-email@gmail.com",
  "app_password": "paste-smtp-key-here",
  "notify_to": "ahmedr.muhammed19@gmail.com"
}
